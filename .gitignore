# Secrets — NE JAMAIS committer
.env
.env.*
!.env.example
*.key

# Données sources et bases locales (données clients : hors dépôt)
*.db
*.sqlite
api/socle/*.db
api/tests/fixtures/*_reel*
data_local/
# Fichiers deposes dans le module Archives (rapports, donnees clients) : jamais au depot.
api/archives_depot/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Next.js / Node
node_modules/
.next/
out/
web/.env*
!web/.env.example

# OS / éditeur
.DS_Store
Thumbs.db
.vscode/

# Déploiement local : sauvegardes de base et fichiers temporaires de Supabase CLI
sauvegardes/
archives_depot/
supabase/.temp/
supabase/.branches/

# Fichiers verrous Office (Word/Excel ouverts)
~$*

# Rapports reglementaires reels et extractions CBS deposes dans docs/ (donnees clients : hors depot)
docs/Rapport_Brouillard_Caisse*
docs/AML_*_rempli*
docs/MFII*.xls
docs/Syst*me de paiement*
