# Connexion Supabase (PostgreSQL). Copier ce fichier en .env et remplir.
# Récupérer l'URL dans Supabase : Project Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://postgres:[MOT_DE_PASSE]@db.qpklywwzpukzjaclhxwd.supabase.co:5432/postgres

# Secret JWT Supabase (Project Settings → API → JWT Settings → JWT Secret)
# Sert à l'API pour vérifier le jeton des utilisateurs (cloisonnement par agence).
SUPABASE_JWT_SECRET=[TON_JWT_SECRET_SUPABASE]

# URL RACINE du projet Supabase (Project Settings -> API -> Project URL).
# Sans chemin ni slash final : ni /rest/v1, ni /auth/v1.
# Sert a recuperer les CLES PUBLIQUES du projet
# (<URL>/auth/v1/.well-known/jwks.json) pour verifier les jetons signes en
# ES256. C'est le regime par defaut des projets Supabase recents ; le
# SUPABASE_JWT_SECRET ci-dessus ne concerne que l'ancien regime HS256.
SUPABASE_URL=https://[REF_PROJET].supabase.co
