# ---------------------------------------------------------------------------
# PopPilot — GABARIT des variables d'environnement du front Next.js.
# Copier ce fichier en `web/.env.local` (ignore par git) et remplacer les
# [A_REMPLIR]. Ne jamais mettre de vraie cle ici : ce fichier est versionne.
# ---------------------------------------------------------------------------

# URL du projet Supabase, ex. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=[A_REMPLIR]

# Cle ANONYME (anon / publishable). JAMAIS la cle service_role dans le front :
# elle contourne le RLS et serait exposee a tous les visiteurs.
NEXT_PUBLIC_SUPABASE_ANON_KEY=[A_REMPLIR]

# API FastAPI qui expose les moteurs valides (api/main.py).
# En local : uvicorn main:app --reload  →  http://localhost:8000
NEXT_PUBLIC_POPPILOT_API=http://localhost:8000
