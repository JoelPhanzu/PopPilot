[Unit]
Description=PopPilot site (Next.js)
After=network.target poppilot-api.service

[Service]
User=poppilot
WorkingDirectory=/opt/poppilot/web
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
